{
  "name": "agent-device-x86sim",
  "version": "0.1.0",
  "description": "Run an iOS simulator on Linux through x86Sim and drive it with agent-device. One package: the agent-device plugin and the `agent-device-x86sim` command.",
  "bin": {
    "agent-device-x86sim": "./dist/cli.js"
  },
  "files": [
    "dist",
    "ax-hook/libx86sim-ax.dylib"
  ],
  "type": "module",
  "exports": {
    "./agent-device": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "agent-device": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "agent-device": ">=0.21.35"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
